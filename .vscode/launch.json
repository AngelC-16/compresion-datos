{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Interfaz visual (app.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Demo en consola (demo.py todo)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/demo.py",
      "args": ["todo"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
